{
  "name": "turning-65-medicare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "npm run fonts",
    "dev": "next dev",
    "prebuild": "npm run fonts",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup/alias.mjs --test \"tests/**/*.test.ts\"",
    "images:fetch": "node scripts/images/fetch.mjs",
    "images": "node scripts/images/build.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:export": "node scripts/check-export.mjs",
    "a11y": "node scripts/a11y-check.mjs",
    "pdf": "next build && node scripts/pdf/render.mjs",
    "pdf:library": "next build && node scripts/pdf/render.mjs --library",
    "pdf:check": "node scripts/pdf/check.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
