# Copy to .env.local for local development. On Vercel, set these in Project Settings →
# Environment Variables (Production and Preview as needed). Never commit real values.

# Canonical site origin used for metadata, sitemap and links in emails.
NEXT_PUBLIC_SITE_URL=https://www.senioraiplans.com

# Resend (https://resend.com): API key and a sender on a verified domain.
# Without RESEND_API_KEY, development logs emails to the console; production tells
# visitors to call instead of pretending a form was sent.
RESEND_API_KEY=
LEADS_FROM_EMAIL="Senior AI Plans <hello@senioraiplans.com>"
# Inbox that receives contact, callback, plan-comparison and newsletter leads.
LEADS_TO_EMAIL=leads@example.com

# Cal.com username or team slug with event types named "phone", "video" and "in-person".
# Empty: the Book a Call page shows the phone number and a callback form instead.
NEXT_PUBLIC_CAL_LINK=

# Crisp website ID. Empty: no chat button.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Set automatically by Vercel; analytics only load when this is "production".
# VERCEL_ENV=production

# Stripe (https://stripe.com): billing for the optional Plus and Family subscriptions.
# Without the secret key or a price id, "Start Plus" / "Start Family" ask visitors to call.
#  - Create two products (Plus, Family), each with a monthly and a yearly recurring price:
#    Plus $9 / $90, Family $19 / $190 (must match src/content/pricing.ts).
#  - Add a webhook endpoint at https://www.senioraiplans.com/api/stripe-webhook for
#    checkout.session.completed, customer.subscription.updated and customer.subscription.deleted.
#  - Turn on the Customer Portal with "cancel subscription", and renewal reminder emails.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
